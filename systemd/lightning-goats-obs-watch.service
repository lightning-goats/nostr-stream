[Unit]
Description=Recover Lightning Goats streams after unexpected OBS exits
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/lightning-goats-obs-watch
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=graphical-session.target

#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

NAK="$(command -v nak || true)"
SYSTEMD_CREDS="$(command -v systemd-creds || true)"
CURL="$(command -v curl || true)"

BUNKER_PUB_FILE="$HOME/.config/nak/bunker.pub"
CLIENT_CRED="$HOME/.config/nak/credentials/nostr-client.cred"
STATE_DIR="$HOME/.local/state/lightning-goats-stream"
ANNOUNCEMENT_DIR="$STATE_DIR/announced"

FALLBACK_IMAGE="https://primaldata.s3.us-east-005.backblazeb2.com/cache/0/6c/63/06c633c820a33a891fa1f3ee248115d7c3accf3e44845da8cf4080a6a1c92c8b.png"

TITLE="⚡ Lightning Goats ⚡ Live Goat Feeder"
SUMMARY="Welcome to the Lightning Goats, the world’s first Bitcoin-powered interactive goat feeder! From morning to evening Mountain Time (GMT -7), you can send sats to treat the herd. When the feeder reaches 100%, it automatically dispenses goodies for the goats."
ANNOUNCEMENT_TEXT="Zap Notes. Feed Goats."
ANNOUNCEMENT_HASHTAG="#CyberHerd"

# Try these individually for NIP-46 RPC.
BUNKER_RELAYS=(
    "nos.lol"
    "relay.damus.io"
)

# Relays used for NIP-53 live-event publication.
PUBLISH_RELAYS=(
    "nos.lol"
    "relay.damus.io"
)

# Relays used for the once-per-YouTube-stream kind-1 announcement note.
ANNOUNCEMENT_RELAYS=(
    "lnb.bolverker.com/nostrrelay/666"
    "nos.lol"
    "nostr.chaima.info"
    "relay.damus.io"
)

die() {
    echo "nostr-stream: $*" >&2
    exit 1
}

check_config() {
    [[ -n "$NAK" ]] || die "nak not found in PATH"
    [[ -n "$SYSTEMD_CREDS" ]] || die "systemd-creds not found in PATH"
    [[ -n "$CURL" ]] || die "curl not found in PATH"
    command -v timeout >/dev/null 2>&1 || die "timeout not found in PATH"

    [[ -s "$BUNKER_PUB_FILE" ]] || die "missing $BUNKER_PUB_FILE"
    [[ -s "$CLIENT_CRED" ]] || die "missing $CLIENT_CRED"

    mkdir -p "$STATE_DIR" "$ANNOUNCEMENT_DIR"
    chmod 700 "$STATE_DIR" "$ANNOUNCEMENT_DIR"
}

bunker_uri() {
    local relay="$1"
    local pub

    pub="$(tr -d '\r\n' < "$BUNKER_PUB_FILE")"

    printf 'bunker://%s?relay=wss%%3A%%2F%%2F%s' \
        "$pub" "$relay"
}

load_client_key() {
    "$SYSTEMD_CREDS" decrypt \
        --user \
        --name=nostr-client \
        "$CLIENT_CRED" -
}

extract_youtube_id() {
    local url="$1"

    if [[ "$url" =~ [\?\&]v=([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "$url" =~ youtu\.be/([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "$url" =~ youtube\.com/(embed|shorts|live)/([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
        return 0
    fi

    return 1
}

resolve_cover_image() {
    local url="$1"
    local video_id=""
    local image=""

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"

    if [[ -n "$video_id" ]]; then
        image="https://i.ytimg.com/vi/${video_id}/maxresdefault.jpg"

        if "$CURL" \
            --fail \
            --silent \
            --location \
            --head \
            --max-time 5 \
            "$image" \
            >/dev/null 2>&1
        then
            printf '%s\n' "$image"
            return
        fi

        image="https://i.ytimg.com/vi/${video_id}/hqdefault.jpg"

        if "$CURL" \
            --fail \
            --silent \
            --location \
            --head \
            --max-time 5 \
            "$image" \
            >/dev/null 2>&1
        then
            printf '%s\n' "$image"
            return
        fi
    fi

    printf '%s\n' "$FALLBACK_IMAGE"
}

publish_with_relays() {
    local relay_group="$1"
    shift

    local -a target_relays
    local relay
    local bunker
    local rc

    case "$relay_group" in
        stream)
            target_relays=("${PUBLISH_RELAYS[@]}")
            ;;
        announcement)
            target_relays=("${ANNOUNCEMENT_RELAYS[@]}")
            ;;
        *)
            die "unknown relay group: $relay_group"
            ;;
    esac

    NOSTR_CLIENT_KEY="$(load_client_key)"
    export NOSTR_CLIENT_KEY

    for relay in "${BUNKER_RELAYS[@]}"; do
        bunker="$(bunker_uri "$relay")"

        echo "NIP-46 signer via wss://$relay ..."

        set +e

        timeout \
            --signal=TERM \
            --kill-after=2s \
            15s \
            "$NAK" --connect-timeout 5s event \
                --sec "$bunker" \
                "$@" \
                "${target_relays[@]}"

        rc=$?
        set -e

        if [[ $rc -eq 0 ]]; then
            unset NOSTR_CLIENT_KEY
            return 0
        fi

        if [[ $rc -eq 124 || $rc -eq 137 ]]; then
            echo "NIP-46 timeout via $relay; trying next relay." >&2
        else
            echo "nak failed via $relay (exit $rc); trying next relay." >&2
        fi
    done

    unset NOSTR_CLIENT_KEY
    return 1
}

publish_stream_event() {
    publish_with_relays stream "$@"
}

publish_announcement_event() {
    publish_with_relays announcement "$@"
}

announce_stream() {
    local url="$1"
    local video_id
    local short_url
    local marker
    local content

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    [[ -n "$video_id" ]] || die "announcement requires a YouTube stream URL"

    marker="$ANNOUNCEMENT_DIR/$video_id"

    if [[ -e "$marker" ]]; then
        echo "Announcement note already published for YouTube video $video_id"
        return 0
    fi

    short_url="https://youtu.be/$video_id"
    content="${ANNOUNCEMENT_TEXT}"$'\n'"${short_url}"$'\n'"${ANNOUNCEMENT_HASHTAG}"

    echo "Publishing once-per-stream Nostr note..."
    echo "  $ANNOUNCEMENT_TEXT"
    echo "  $short_url"
    echo "  $ANNOUNCEMENT_HASHTAG"

    if ! publish_announcement_event \
        -k 1 \
        -c "$content" \
        -t 'r=wss://lnb.bolverker.com/nostrrelay/666' \
        -t 'r=wss://nos.lol/' \
        -t 'r=wss://nostr.chaima.info/' \
        -t 'r=wss://relay.damus.io/' \
        -t 't=cyberherd' \
        -t 'client=nostr-stream'
    then
        echo "nostr-stream: announcement note publication failed" >&2
        return 1
    fi

    printf '%s\n' "$(date +%s)" > "$marker"
    chmod 600 "$marker"

    echo "Announcement note published for YouTube video $video_id"
}

start_stream() {
    local url="$1"
    local start
    local stream_id
    local image

    [[ ! -e "$STATE_DIR/active" ]] || \
        die "stream already active; use: nostr-stream status"

    start="$(date +%s)"
    stream_id="lightning-goats-$(date -u +%Y%m%dT%H%M%SZ)"
    image="$(resolve_cover_image "$url")"

    echo "Publishing Nostr live event..."
    echo "Stream URL:  $url"
    echo "Cover image: $image"

    if ! publish_stream_event \
        -k 30311 \
        -d "$stream_id" \
        -c '' \
        -t "title=$TITLE" \
        -t "summary=$SUMMARY" \
        -t "streaming=$url" \
        -t "image=$image" \
        -t "starts=$start" \
        -t 'status=live' \
        -t 't=bitcoin' \
        -t 't=lightning' \
        -t 't=goats'
    then
        die "could not publish live event"
    fi

    printf '%s\n' "$url"       > "$STATE_DIR/url"
    printf '%s\n' "$stream_id" > "$STATE_DIR/id"
    printf '%s\n' "$start"     > "$STATE_DIR/start"
    printf '%s\n' "$image"     > "$STATE_DIR/image"
    touch "$STATE_DIR/active"

    echo
    echo "Nostr stream LIVE"
    echo "  id:    $stream_id"
    echo "  video: $url"
    echo "  cover: $image"

    # The live-event publication succeeded, so a failure to publish the
    # promotional kind-1 note must not roll back the live state. The watcher
    # will retry `announce` on later polls until the marker is written.
    if ! announce_stream "$url"; then
        echo "nostr-stream: live event is active; announcement will need retry" >&2
    fi
}

stop_stream() {
    [[ -e "$STATE_DIR/active" ]] || die "no active stream"

    local url
    local stream_id
    local start
    local end
    local image

    url="$(cat "$STATE_DIR/url")"
    stream_id="$(cat "$STATE_DIR/id")"
    start="$(cat "$STATE_DIR/start")"
    end="$(date +%s)"

    if [[ -s "$STATE_DIR/image" ]]; then
        image="$(cat "$STATE_DIR/image")"
    else
        image="$FALLBACK_IMAGE"
    fi

    echo "Publishing Nostr ended event..."

    if ! publish_stream_event \
        -k 30311 \
        -d "$stream_id" \
        -c '' \
        -t "title=$TITLE" \
        -t "summary=$SUMMARY" \
        -t "streaming=$url" \
        -t "recording=$url" \
        -t "image=$image" \
        -t "starts=$start" \
        -t "ends=$end" \
        -t 'status=ended' \
        -t 't=bitcoin' \
        -t 't=lightning' \
        -t 't=goats'
    then
        die "could not publish ended event; active state preserved"
    fi

    rm -f \
        "$STATE_DIR/active" \
        "$STATE_DIR/url" \
        "$STATE_DIR/id" \
        "$STATE_DIR/start" \
        "$STATE_DIR/image"

    echo
    echo "Nostr stream ENDED"
    echo "  id:    $stream_id"
    echo "  video: $url"
    echo "  cover: $image"
}

status_stream() {
    local image
    local url
    local video_id
    local note_status="n/a"

    if [[ ! -e "$STATE_DIR/active" ]]; then
        echo "No stream is marked active."
        return
    fi

    url="$(cat "$STATE_DIR/url")"

    if [[ -s "$STATE_DIR/image" ]]; then
        image="$(cat "$STATE_DIR/image")"
    else
        image="$FALLBACK_IMAGE"
    fi

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    if [[ -n "$video_id" ]]; then
        if [[ -e "$ANNOUNCEMENT_DIR/$video_id" ]]; then
            note_status="published"
        else
            note_status="pending"
        fi
    fi

    echo "Nostr stream LIVE"
    echo "  id:    $(cat "$STATE_DIR/id")"
    echo "  video: $url"
    echo "  cover: $image"
    echo "  start: $(cat "$STATE_DIR/start")"
    echo "  note:  $note_status"
}

check_config

case "${1:-}" in
    start)
        [[ $# -eq 2 ]] || die "usage: nostr-stream start <stream-url>"
        start_stream "$2"
        ;;

    stop)
        [[ $# -eq 1 ]] || die "usage: nostr-stream stop"
        stop_stream
        ;;

    announce)
        [[ $# -eq 2 ]] || die "usage: nostr-stream announce <youtube-url>"
        announce_stream "$2"
        ;;

    status)
        [[ $# -eq 1 ]] || die "usage: nostr-stream status"
        status_stream
        ;;

    *)
        echo "Usage:"
        echo "  nostr-stream start <stream-url>"
        echo "  nostr-stream stop"
        echo "  nostr-stream announce <youtube-url>"
        echo "  nostr-stream status"
        exit 2
        ;;
esac

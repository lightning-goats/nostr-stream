#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

NAK="$(command -v nak || true)"
SYSTEMD_CREDS="$(command -v systemd-creds || true)"
CURL="$(command -v curl || true)"

BUNKER_PUB_FILE="$HOME/.config/nak/bunker.pub"
CLIENT_CRED="$HOME/.config/nak/credentials/nostr-client.cred"
STATE_DIR="$HOME/.local/state/lightning-goats-stream"
ANNOUNCEMENT_DIR="$STATE_DIR/announced"
GOAL_DIR="$STATE_DIR/goals"
LAST_REFRESH_FILE="$STATE_DIR/last-refresh"
GOAL_ID_FILE="$STATE_DIR/goal-id"
GOAL_VIDEO_FILE="$STATE_DIR/goal-video-id"

FALLBACK_IMAGE="https://primaldata.s3.us-east-005.backblazeb2.com/cache/0/6c/63/06c633c820a33a891fa1f3ee248115d7c3accf3e44845da8cf4080a6a1c92c8b.png"

TITLE="⚡ Lightning Goats ⚡ Live Goat Feeder"
SUMMARY="Welcome to the Lightning Goats, the world’s first Bitcoin-powered interactive goat feeder! From morning to evening Mountain Time (GMT -7), you can send sats to treat the herd. When the feeder reaches 100%, it automatically dispenses goodies for the goats."
ANNOUNCEMENT_TEXT="Zap Notes. Feed Goats."
ANNOUNCEMENT_HASHTAG="#CyberHerd"

# One NIP-75 goal per YouTube broadcast: 10,000 sats = 10,000,000 millisats.
GOAL_AMOUNT_MSAT="10000000"
GOAL_AMOUNT_SATS="10000"
GOAL_CONTENT="Feed the Lightning Goats — help trigger 10 feedings today!"
GOAL_SUMMARY="10,000 sats funds up to 10 Lightning-powered goat feedings at 1,000 sats each."
GOAL_RELAY_HINT="wss://nos.lol/"

# Try these individually for NIP-46 RPC.
BUNKER_RELAYS=(
    "nos.lol"
    "relay.damus.io"
)

# Relays used for NIP-53 live-event, NIP-75 goal, and deletion publication.
PUBLISH_RELAYS=(
    "nos.lol"
    "relay.damus.io"
)

# Relays used for the once-per-YouTube-stream kind-1 announcement note.
ANNOUNCEMENT_RELAYS=(
    "lnb.bolverker.com/nostrrelay/666"
    "nos.lol"
    "nostr.chaima.info"
    "relay.damus.io"
)

LAST_EVENT_ID=""
ENSURED_GOAL_ID=""

die() {
    echo "nostr-stream: $*" >&2
    exit 1
}

check_config() {
    [[ -n "$NAK" ]] || die "nak not found in PATH"
    [[ -n "$SYSTEMD_CREDS" ]] || die "systemd-creds not found in PATH"
    [[ -n "$CURL" ]] || die "curl not found in PATH"
    command -v timeout >/dev/null 2>&1 || die "timeout not found in PATH"

    [[ -s "$BUNKER_PUB_FILE" ]] || die "missing $BUNKER_PUB_FILE"
    [[ -s "$CLIENT_CRED" ]] || die "missing $CLIENT_CRED"

    mkdir -p "$STATE_DIR" "$ANNOUNCEMENT_DIR" "$GOAL_DIR"
    chmod 700 "$STATE_DIR" "$ANNOUNCEMENT_DIR" "$GOAL_DIR"
}

bunker_uri() {
    local relay="$1"
    local pub

    pub="$(tr -d '\r\n' < "$BUNKER_PUB_FILE")"

    printf 'bunker://%s?relay=wss%%3A%%2F%%2F%s' \
        "$pub" "$relay"
}

load_client_key() {
    "$SYSTEMD_CREDS" decrypt \
        --user \
        --name=nostr-client \
        "$CLIENT_CRED" -
}

extract_youtube_id() {
    local url="$1"

    if [[ "$url" =~ [\?\&]v=([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "$url" =~ youtu\.be/([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "$url" =~ youtube\.com/(embed|shorts|live)/([A-Za-z0-9_-]{11}) ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
        return 0
    fi

    return 1
}

resolve_cover_image() {
    local url="$1"
    local video_id=""
    local image=""

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"

    if [[ -n "$video_id" ]]; then
        image="https://i.ytimg.com/vi/${video_id}/maxresdefault.jpg"

        if "$CURL" \
            --fail \
            --silent \
            --location \
            --head \
            --max-time 5 \
            "$image" \
            >/dev/null 2>&1
        then
            printf '%s\n' "$image"
            return
        fi

        image="https://i.ytimg.com/vi/${video_id}/hqdefault.jpg"

        if "$CURL" \
            --fail \
            --silent \
            --location \
            --head \
            --max-time 5 \
            "$image" \
            >/dev/null 2>&1
        then
            printf '%s\n' "$image"
            return
        fi
    fi

    printf '%s\n' "$FALLBACK_IMAGE"
}

publish_with_relays() {
    local relay_group="$1"
    shift

    local -a target_relays
    local relay
    local bunker
    local rc
    local output

    case "$relay_group" in
        stream)
            target_relays=("${PUBLISH_RELAYS[@]}")
            ;;
        announcement)
            target_relays=("${ANNOUNCEMENT_RELAYS[@]}")
            ;;
        *)
            die "unknown relay group: $relay_group"
            ;;
    esac

    NOSTR_CLIENT_KEY="$(load_client_key)"
    export NOSTR_CLIENT_KEY
    LAST_EVENT_ID=""

    for relay in "${BUNKER_RELAYS[@]}"; do
        bunker="$(bunker_uri "$relay")"

        echo "NIP-46 signer via wss://$relay ..."

        set +e
        output="$(
            timeout \
                --signal=TERM \
                --kill-after=2s \
                15s \
                "$NAK" --connect-timeout 5s event \
                    --sec "$bunker" \
                    "$@" \
                    "${target_relays[@]}" \
                2>&1
        )"
        rc=$?
        set -e

        [[ -z "$output" ]] || printf '%s\n' "$output"

        if [[ $rc -eq 0 ]]; then
            LAST_EVENT_ID="$(
                printf '%s\n' "$output" |
                    sed -nE 's/.*"id":"([0-9a-f]{64})".*/\1/p' |
                    head -n1
            )"
            unset NOSTR_CLIENT_KEY
            return 0
        fi

        if [[ $rc -eq 124 || $rc -eq 137 ]]; then
            echo "NIP-46 timeout via $relay; trying next relay." >&2
        else
            echo "nak failed via $relay (exit $rc); trying next relay." >&2
        fi
    done

    unset NOSTR_CLIENT_KEY
    return 1
}

publish_stream_event() {
    publish_with_relays stream "$@"
}

publish_announcement_event() {
    publish_with_relays announcement "$@"
}

ensure_goal() {
    local url="$1"
    local image="$2"
    local video_id
    local marker
    local short_url
    local goal_id=""

    ENSURED_GOAL_ID=""
    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"

    if [[ -z "$video_id" ]]; then
        echo "No YouTube video ID; skipping NIP-75 zap goal." >&2
        return 0
    fi

    marker="$GOAL_DIR/$video_id"

    if [[ -s "$marker" ]]; then
        goal_id="$(tr -d '\r\n' < "$marker")"
        if [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]]; then
            ENSURED_GOAL_ID="$goal_id"
            printf '%s\n' "$goal_id" > "$GOAL_ID_FILE"
            printf '%s\n' "$video_id" > "$GOAL_VIDEO_FILE"
            chmod 600 "$GOAL_ID_FILE" "$GOAL_VIDEO_FILE"
            echo "Reusing NIP-75 zap goal for YouTube video $video_id"
            echo "  goal: $goal_id"
            return 0
        fi
    fi

    short_url="https://youtu.be/$video_id"

    echo "Publishing 10,000-sat NIP-75 zap goal..."
    echo "  video: $short_url"
    echo "  target: $GOAL_AMOUNT_SATS sats"

    if ! publish_stream_event \
        -k 9041 \
        -c "$GOAL_CONTENT" \
        -t "amount=$GOAL_AMOUNT_MSAT" \
        -t 'relays=wss://nos.lol/;wss://relay.damus.io/' \
        -t "summary=$GOAL_SUMMARY" \
        -t "image=$image" \
        -t "r=$short_url" \
        -t 'client=nostr-stream'
    then
        echo "nostr-stream: zap-goal publication failed" >&2
        return 1
    fi

    goal_id="$LAST_EVENT_ID"
    [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]] || {
        echo "nostr-stream: goal published but event id could not be captured" >&2
        return 1
    }

    printf '%s\n' "$goal_id" > "$marker"
    printf '%s\n' "$goal_id" > "$GOAL_ID_FILE"
    printf '%s\n' "$video_id" > "$GOAL_VIDEO_FILE"
    chmod 600 "$marker" "$GOAL_ID_FILE" "$GOAL_VIDEO_FILE"

    ENSURED_GOAL_ID="$goal_id"
    echo "NIP-75 zap goal published"
    echo "  goal: $goal_id"
}

delete_goal() {
    local video_id="$1"
    local goal_id="$2"
    local marker="$GOAL_DIR/$video_id"

    [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]] || return 0

    echo "Requesting deletion of completed NIP-75 zap goal..."
    echo "  goal: $goal_id"

    if ! publish_stream_event \
        -k 5 \
        -c 'Lightning Goats stream ended; retiring zap goal.' \
        -t "e=$goal_id" \
        -t 'k=9041'
    then
        echo "nostr-stream: zap-goal deletion request failed" >&2
        return 1
    fi

    rm -f "$marker"
    echo "Zap-goal deletion request published"
}

publish_live_state() {
    local url="$1"
    local stream_id="$2"
    local start="$3"
    local image="$4"
    local goal_id="${5:-}"
    local -a goal_args=()

    if [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]]; then
        goal_args=(-t "goal=$goal_id;$GOAL_RELAY_HINT")
    fi

    publish_stream_event \
        -k 30311 \
        -d "$stream_id" \
        -c '' \
        -t "title=$TITLE" \
        -t "summary=$SUMMARY" \
        -t "streaming=$url" \
        -t "image=$image" \
        -t "starts=$start" \
        -t 'status=live' \
        "${goal_args[@]}" \
        -t 't=bitcoin' \
        -t 't=lightning' \
        -t 't=goats'
}

publish_ended_state() {
    local url="$1"
    local stream_id="$2"
    local start="$3"
    local end="$4"
    local image="$5"
    local goal_id="${6:-}"
    local -a goal_args=()

    if [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]]; then
        goal_args=(-t "goal=$goal_id;$GOAL_RELAY_HINT")
    fi

    publish_stream_event \
        -k 30311 \
        -d "$stream_id" \
        -c '' \
        -t "title=$TITLE" \
        -t "summary=$SUMMARY" \
        -t "streaming=$url" \
        -t "recording=$url" \
        -t "image=$image" \
        -t "starts=$start" \
        -t "ends=$end" \
        -t 'status=ended' \
        "${goal_args[@]}" \
        -t 't=bitcoin' \
        -t 't=lightning' \
        -t 't=goats'
}

announce_stream() {
    local url="$1"
    local video_id
    local short_url
    local marker
    local content

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    [[ -n "$video_id" ]] || die "announcement requires a YouTube stream URL"

    marker="$ANNOUNCEMENT_DIR/$video_id"

    if [[ -e "$marker" ]]; then
        echo "Announcement note already published for YouTube video $video_id"
        return 0
    fi

    short_url="https://youtu.be/$video_id"
    content="${ANNOUNCEMENT_TEXT}"$'\n'"${short_url}"$'\n'"${ANNOUNCEMENT_HASHTAG}"

    echo "Publishing once-per-stream Nostr note..."
    echo "  $ANNOUNCEMENT_TEXT"
    echo "  $short_url"
    echo "  $ANNOUNCEMENT_HASHTAG"

    if ! publish_announcement_event \
        -k 1 \
        -c "$content" \
        -t 'r=wss://lnb.bolverker.com/nostrrelay/666' \
        -t 'r=wss://nos.lol/' \
        -t 'r=wss://nostr.chaima.info/' \
        -t 'r=wss://relay.damus.io/' \
        -t 't=cyberherd' \
        -t 'client=nostr-stream'
    then
        echo "nostr-stream: announcement note publication failed" >&2
        return 1
    fi

    printf '%s\n' "$(date +%s)" > "$marker"
    chmod 600 "$marker"

    echo "Announcement note published for YouTube video $video_id"
}

start_stream() {
    local url="$1"
    local start
    local stream_id
    local image
    local goal_id=""
    local now

    [[ ! -e "$STATE_DIR/active" ]] || \
        die "stream already active; use: nostr-stream status"

    start="$(date +%s)"
    stream_id="lightning-goats-$(date -u +%Y%m%dT%H%M%SZ)"
    image="$(resolve_cover_image "$url")"

    if ! ensure_goal "$url" "$image"; then
        die "could not create or recover zap goal"
    fi
    goal_id="$ENSURED_GOAL_ID"

    echo "Publishing Nostr live event..."
    echo "Stream URL:  $url"
    echo "Cover image: $image"
    [[ -z "$goal_id" ]] || echo "Zap goal:    $goal_id ($GOAL_AMOUNT_SATS sats)"

    if ! publish_live_state "$url" "$stream_id" "$start" "$image" "$goal_id"; then
        die "could not publish live event"
    fi

    now="$(date +%s)"
    printf '%s\n' "$url"       > "$STATE_DIR/url"
    printf '%s\n' "$stream_id" > "$STATE_DIR/id"
    printf '%s\n' "$start"     > "$STATE_DIR/start"
    printf '%s\n' "$image"     > "$STATE_DIR/image"
    printf '%s\n' "$now"       > "$LAST_REFRESH_FILE"
    touch "$STATE_DIR/active"

    echo
    echo "Nostr stream LIVE"
    echo "  id:    $stream_id"
    echo "  video: $url"
    echo "  cover: $image"
    [[ -z "$goal_id" ]] || echo "  goal:  $goal_id ($GOAL_AMOUNT_SATS sats)"

    if ! announce_stream "$url"; then
        echo "nostr-stream: live event is active; announcement will need retry" >&2
    fi
}

refresh_stream() {
    [[ -e "$STATE_DIR/active" ]] || die "no active stream"

    local url
    local stream_id
    local start
    local image
    local goal_id=""
    local now

    url="$(cat "$STATE_DIR/url")"
    stream_id="$(cat "$STATE_DIR/id")"
    start="$(cat "$STATE_DIR/start")"

    if [[ -s "$STATE_DIR/image" ]]; then
        image="$(cat "$STATE_DIR/image")"
    else
        image="$FALLBACK_IMAGE"
    fi

    # This also upgrades an already-running pre-goal stream on its next refresh.
    if ! ensure_goal "$url" "$image"; then
        echo "nostr-stream: could not create or recover zap goal for refresh" >&2
        return 1
    fi
    goal_id="$ENSURED_GOAL_ID"

    echo "Refreshing Nostr live event..."

    if ! publish_live_state "$url" "$stream_id" "$start" "$image" "$goal_id"; then
        echo "nostr-stream: live-event refresh failed" >&2
        return 1
    fi

    now="$(date +%s)"
    printf '%s\n' "$now" > "$LAST_REFRESH_FILE"
    chmod 600 "$LAST_REFRESH_FILE"

    echo "Nostr stream refreshed"
    echo "  id:    $stream_id"
    echo "  video: $url"
    [[ -z "$goal_id" ]] || echo "  goal:  $goal_id ($GOAL_AMOUNT_SATS sats)"
}

refresh_if_due() {
    local minimum_age="${1:-1200}"
    local now
    local last=0

    [[ "$minimum_age" =~ ^[0-9]+$ ]] || die "refresh interval must be seconds"
    [[ -e "$STATE_DIR/active" ]] || return 0

    if [[ -s "$LAST_REFRESH_FILE" ]]; then
        last="$(cat "$LAST_REFRESH_FILE")"
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
    fi

    now="$(date +%s)"

    if (( now - last < minimum_age )); then
        return 0
    fi

    refresh_stream
}

stop_stream() {
    local delete_goal_after="${1:-false}"

    [[ -e "$STATE_DIR/active" ]] || die "no active stream"
    [[ "$delete_goal_after" == "true" || "$delete_goal_after" == "false" ]] || \
        die "invalid stop mode"

    local url
    local stream_id
    local start
    local end
    local image
    local video_id=""
    local goal_id=""

    url="$(cat "$STATE_DIR/url")"
    stream_id="$(cat "$STATE_DIR/id")"
    start="$(cat "$STATE_DIR/start")"
    end="$(date +%s)"

    if [[ -s "$STATE_DIR/image" ]]; then
        image="$(cat "$STATE_DIR/image")"
    else
        image="$FALLBACK_IMAGE"
    fi

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    if [[ -s "$GOAL_ID_FILE" ]]; then
        goal_id="$(tr -d '\r\n' < "$GOAL_ID_FILE")"
    elif [[ -n "$video_id" && -s "$GOAL_DIR/$video_id" ]]; then
        goal_id="$(tr -d '\r\n' < "$GOAL_DIR/$video_id")"
    fi

    echo "Publishing Nostr ended event..."

    if ! publish_ended_state "$url" "$stream_id" "$start" "$end" "$image" "$goal_id"; then
        die "could not publish ended event; active state preserved"
    fi

    if [[ "$delete_goal_after" == "true" && -n "$video_id" && -n "$goal_id" ]]; then
        if ! delete_goal "$video_id" "$goal_id"; then
            die "stream ended, but zap-goal deletion failed; active state preserved for retry"
        fi
    fi

    rm -f \
        "$STATE_DIR/active" \
        "$STATE_DIR/url" \
        "$STATE_DIR/id" \
        "$STATE_DIR/start" \
        "$STATE_DIR/image" \
        "$LAST_REFRESH_FILE" \
        "$GOAL_ID_FILE" \
        "$GOAL_VIDEO_FILE"

    echo
    echo "Nostr stream ENDED"
    echo "  id:    $stream_id"
    echo "  video: $url"
    echo "  cover: $image"
    if [[ -n "$goal_id" ]]; then
        if [[ "$delete_goal_after" == "true" ]]; then
            echo "  goal:  $goal_id (deletion requested)"
        else
            echo "  goal:  $goal_id (preserved)"
        fi
    fi
}

delete_goal_for_url() {
    local url="$1"
    local video_id
    local marker
    local goal_id

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    [[ -n "$video_id" ]] || die "delete-goal requires a YouTube stream URL"

    marker="$GOAL_DIR/$video_id"
    [[ -s "$marker" ]] || die "no stored zap goal for YouTube video $video_id"

    goal_id="$(tr -d '\r\n' < "$marker")"
    [[ "$goal_id" =~ ^[0-9a-f]{64}$ ]] || die "invalid stored zap-goal event id"

    delete_goal "$video_id" "$goal_id"
}

status_stream() {
    local image
    local url
    local video_id
    local note_status="n/a"
    local last_refresh="n/a"
    local goal_id="n/a"

    if [[ ! -e "$STATE_DIR/active" ]]; then
        echo "No stream is marked active."
        return
    fi

    url="$(cat "$STATE_DIR/url")"

    if [[ -s "$STATE_DIR/image" ]]; then
        image="$(cat "$STATE_DIR/image")"
    else
        image="$FALLBACK_IMAGE"
    fi

    video_id="$(extract_youtube_id "$url" 2>/dev/null || true)"
    if [[ -n "$video_id" ]]; then
        if [[ -e "$ANNOUNCEMENT_DIR/$video_id" ]]; then
            note_status="published"
        else
            note_status="pending"
        fi
    fi

    if [[ -s "$LAST_REFRESH_FILE" ]]; then
        last_refresh="$(cat "$LAST_REFRESH_FILE")"
    fi

    if [[ -s "$GOAL_ID_FILE" ]]; then
        goal_id="$(tr -d '\r\n' < "$GOAL_ID_FILE")"
    elif [[ -n "$video_id" && -s "$GOAL_DIR/$video_id" ]]; then
        goal_id="$(tr -d '\r\n' < "$GOAL_DIR/$video_id")"
    fi

    echo "Nostr stream LIVE"
    echo "  id:           $(cat "$STATE_DIR/id")"
    echo "  video:        $url"
    echo "  cover:        $image"
    echo "  start:        $(cat "$STATE_DIR/start")"
    echo "  last-refresh: $last_refresh"
    echo "  goal:         $goal_id"
    if [[ "$goal_id" != "n/a" ]]; then
        echo "  goal-target:  $GOAL_AMOUNT_SATS sats"
    fi
    echo "  note:         $note_status"
}

check_config

case "${1:-}" in
    start)
        [[ $# -eq 2 ]] || die "usage: nostr-stream start <stream-url>"
        start_stream "$2"
        ;;

    stop)
        if [[ $# -eq 1 ]]; then
            stop_stream false
        elif [[ $# -eq 2 && "$2" == "--delete-goal" ]]; then
            stop_stream true
        else
            die "usage: nostr-stream stop [--delete-goal]"
        fi
        ;;

    refresh)
        [[ $# -eq 1 ]] || die "usage: nostr-stream refresh"
        refresh_stream
        ;;

    refresh-if-due)
        [[ $# -le 2 ]] || die "usage: nostr-stream refresh-if-due [seconds]"
        refresh_if_due "${2:-1200}"
        ;;

    announce)
        [[ $# -eq 2 ]] || die "usage: nostr-stream announce <youtube-url>"
        announce_stream "$2"
        ;;

    delete-goal)
        [[ $# -eq 2 ]] || die "usage: nostr-stream delete-goal <youtube-url>"
        delete_goal_for_url "$2"
        ;;

    status)
        [[ $# -eq 1 ]] || die "usage: nostr-stream status"
        status_stream
        ;;

    *)
        echo "Usage:"
        echo "  nostr-stream start <stream-url>"
        echo "  nostr-stream stop [--delete-goal]"
        echo "  nostr-stream refresh"
        echo "  nostr-stream refresh-if-due [seconds]"
        echo "  nostr-stream announce <youtube-url>"
        echo "  nostr-stream delete-goal <youtube-url>"
        echo "  nostr-stream status"
        exit 2
        ;;
esac
